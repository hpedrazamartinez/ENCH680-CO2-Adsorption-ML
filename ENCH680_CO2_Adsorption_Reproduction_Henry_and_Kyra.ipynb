        "grids = {\n",
        "    \"GBDT\": (GradientBoostingRegressor(random_state=SEED),\n",
        "             {\"n_estimators\": [100, 300, 500], \"learning_rate\": [0.02, 0.05, 0.1],\n",
        "              \"max_depth\": [3, 4, 5], \"subsample\": [0.5, 0.8, 1.0]}),\n",
        "    \"XGB\": (XGBRegressor(random_state=SEED, eval_metric=\"rmse\", n_jobs=1),\n",
        "            {\"n_estimators\": [100, 300, 500], \"learning_rate\": [0.02, 0.05, 0.1],\n",
        "             \"max_depth\": [3, 4, 5], \"subsample\": [0.5, 0.8, 1.0]}),\n",
        "    \"LGB\": (LGBMRegressor(random_state=SEED, verbose=-1, n_jobs=1),\n",
        "            {\"n_estimators\": [100, 300, 500], \"learning_rate\": [0.02, 0.05, 0.1],\n",
        "             \"num_leaves\": [5, 15, 31], \"min_child_samples\": [5, 10, 20]}),\n",
        "}\n",
        "tuned_params = {}\n",
        "for k, (est, g) in grids.items():\n",
        "    gs = GridSearchCV(est, g, cv=cv5, scoring=\"r2\", n_jobs=-1).fit(X_train, y_train)\n",
        "    tuned_params[k] = gs.best_params_\n",
        "    print(k, \"best params:\", gs.best_params_)\n",
        "    r, m, ptr, pte = evaluate(f\"{k} (our grid search)\", est.set_params(**gs.best_params_))\n",
        "    rows.append(r); models[r[\"model\"]] = m; preds[r[\"model\"]] = (ptr, pte)\n",
        "RESULTS[\"tuned_params\"] = tuned_params\n",
        "results = pd.DataFrame(rows).set_index(\"model\")\n",
        "RESULTS[\"main_table\"] = results.round(4).reset_index().to_dict(orient=\"records\")\n",
        "results.round(3)"
      ],
