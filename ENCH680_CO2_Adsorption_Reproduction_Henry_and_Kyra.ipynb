            "Train: (447, 9) Test: (80, 9)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 4. Chapter 3 baselines: decision tree and random forest\n",
        "Chapter 3 shows that a single tree with no limits keeps splitting until each leaf is pure, which leads to overfitting. Pre-pruning (max_depth, min_samples_split, min_samples_leaf) controls this. A random forest averages many bootstrapped, decorrelated trees to reduce variance."
      ],
      "metadata": {
        "id": "vik0zXUM98EI"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "rows, models, preds = [], {}, {}\n",
        "\n",
        "r, m, ptr, pte = evaluate(\"Decision tree (unpruned)\", DecisionTreeRegressor(random_state=SEED))\n",
        "rows.append(r); models[r[\"model\"]] = m; preds[r[\"model\"]] = (ptr, pte)\n",
        "print(\"Unpruned tree depth:\", m.get_depth(), \"| leaves:\", m.get_n_leaves())\n",
        "\n",
        "dt_grid = GridSearchCV(DecisionTreeRegressor(random_state=SEED),\n",
        "                       {\"max_depth\": [3, 4, 5, 6, 8, 10, None],\n",
        "                        \"min_samples_split\": [2, 5, 10, 20],\n",
        "                        \"min_samples_leaf\": [1, 2, 4, 8]}, cv=cv5, scoring=\"r2\", n_jobs=-1).fit(X_train, y_train)\n",
        "print(\"Pre-pruned tree best params:\", dt_grid.best_params_)\n",
        "r, m, ptr, pte = evaluate(\"Decision tree (pre-pruned)\", DecisionTreeRegressor(random_state=SEED, **dt_grid.best_params_))\n",
        "rows.append(r); models[r[\"model\"]] = m; preds[r[\"model\"]] = (ptr, pte)\n",
        "\n",
        "rf_grid = GridSearchCV(RandomForestRegressor(random_state=SEED, n_jobs=-1),\n",
        "                       {\"n_estimators\": [200, 500], \"max_depth\": [None, 10, 6],\n",
        "                        \"max_features\": [1.0, 0.6, 0.33], \"min_samples_leaf\": [1, 2]},\n",
        "                       cv=cv5, scoring=\"r2\", n_jobs=-1).fit(X_train, y_train)\n",
        "print(\"Random forest best params:\", rf_grid.best_params_)\n",
        "r, m, ptr, pte = evaluate(\"Random forest (tuned)\", RandomForestRegressor(random_state=SEED, n_jobs=-1, **rf_grid.best_params_))\n",
        "rows.append(r); models[r[\"model\"]] = m; preds[r[\"model\"]] = (ptr, pte)\n",
        "RESULTS[\"dt_params\"] = dt_grid.best_params_; RESULTS[\"rf_params\"] = rf_grid.best_params_\n",
        "pd.DataFrame(rows).round(3)"
      ],
