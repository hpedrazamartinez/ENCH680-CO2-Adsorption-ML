      "source": [
        "## 5. Reproducing the paper: GBDT, XGBoost, LightGBM\n",
        "5a. With the authors' final hyperparameters (taken from their published notebook).\n",
        "\n",
        "5b. With our own grid search (5-fold CV on the training set), as the paper describes."
      ],
      "metadata": {
        "id": "Jbpbfc-wB43d"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "paper_models = {\n",
        "    \"GBDT\": GradientBoostingRegressor(learning_rate=0.05, max_depth=4, min_samples_leaf=1, min_samples_split=2,\n",
        "                                      n_estimators=300, subsample=0.5, random_state=SEED),\n",
        "    \"XGB\": XGBRegressor(colsample_bytree=1, learning_rate=0.05, max_depth=4, n_estimators=100,\n",
        "                        subsample=0.5, random_state=SEED, eval_metric=\"rmse\"),\n",
        "    \"LGB\": LGBMRegressor(boosting_type=\"dart\", colsample_bytree=1, learning_rate=0.2, max_depth=4,\n",
        "                         n_estimators=300, num_leaves=5, reg_lambda=0.8, subsample=1, random_state=SEED, verbose=-1),\n",
        "}\n",
        "for k, m in paper_models.items():\n",
        "    r, m, ptr, pte = evaluate(f\"{k} (authors' hyperparameters)\", m)\n",
        "    rows.append(r); models[r[\"model\"]] = m; preds[r[\"model\"]] = (ptr, pte)\n",
        "pd.DataFrame(rows).round(3).tail(3)"
      ],
