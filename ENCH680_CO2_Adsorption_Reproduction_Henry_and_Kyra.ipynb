      "cell_type": "markdown",
      "source": [
        "TPV and MPV are strongly correlated with surface area (SA), so the authors imputed the missing values with a random forest that uses SA as the only input (80/20 split). After that, S (%) is dropped, which leaves 9 input features."
      ],
      "metadata": {
        "id": "l5oCoGLOF26k"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "SA = \"Surface Area (m2/g)\"; TPV = \"Total Pore Volume(cm3/g)\"; MPV = \"Micropore Volume (cm3/g)\"\n",
        "TARGET = \"CO2 uptake (mmol/g)\"\n",
        "df = raw.copy()\n",
        "imp_rows = []\n",
        "for col in [TPV, MPV]:\n",
        "    known = df[[SA, col]].dropna()\n",
        "    Xk, yk = known[[SA]].values, known[col].values\n",
        "    Xtr, Xte, ytr, yte = train_test_split(Xk, yk, test_size=0.2, random_state=SEED)\n",
        "    for name, m in [(\"Linear regression\", LinearRegression()), (\"Random forest\", RandomForestRegressor(random_state=SEED))]:\n",
        "        m.fit(Xtr, ytr)\n",
        "        imp_rows.append([col, name, r2_score(ytr, m.predict(Xtr)), r2_score(yte, m.predict(Xte))])\n",
        "    rf_imp = RandomForestRegressor(random_state=SEED).fit(Xtr, ytr)\n",
        "    miss = df[col].isna()\n",
        "    df.loc[miss, col] = rf_imp.predict(df.loc[miss, [SA]].values)\n",
        "    print(f\"{col}: imputed {miss.sum()} values\")\n",
        "imp = pd.DataFrame(imp_rows, columns=[\"feature\", \"model\", \"train R2\", \"test R2\"]).round(3)\n",
        "RESULTS[\"imputation\"] = imp.to_dict(orient=\"records\")\n",
        "df = df.drop(columns=[\"S (%)\"])\n",
        "FEATURES = [c for c in df.columns if c != TARGET]\n",
        "print(\"Features used:\", FEATURES)\n",
        "imp"
      ],
