import hashlib
import os

# Dataset provenance
DATA_URL = "https://raw.githubusercontent.com/hpedrazamartinez/ENCH680-CO2-Adsorption-ML/main/data.xlsx"

# Generate SHA-256 checksum
with open("data.xlsx", "rb") as f:
    dataset_hash = hashlib.sha256(f.read()).hexdigest()

print("Dataset URL:", DATA_URL)
print("Dataset SHA-256:", dataset_hash)

# Dataset integrity checks
assert raw.shape == (527, 11), "Unexpected dataset dimensions"

required_columns = [
    SA, TPV, MPV, TARGET, "S (%)"
]

assert all(col in raw.columns for col in required_columns), \
    "Missing required dataset columns"

assert raw[TARGET].notna().all(), \
    "Missing values detected in target variable"

print("\nDataset integrity checks passed.")
print("Dataset dimensions:", raw.shape)
print("Missing TPV values:", raw[TPV].isna().sum())
print("Missing MPV values:", raw[MPV].isna().sum())
