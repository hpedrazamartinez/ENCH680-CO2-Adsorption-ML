      "cell_type": "markdown",
      "source": [
        "## 3. Train/test split (85/15, random_state=42, same as the authors' code)"
      ],
      "metadata": {
        "id": "HuByku5z9kQw"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "df[FEATURES] = df[FEATURES].astype(float)\n",
        "X, y = df[FEATURES], df[TARGET]\n",
        "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.15, random_state=SEED)\n",
        "print(\"Train:\", X_train.shape, \"Test:\", X_test.shape)\n",
        "cv5 = KFold(n_splits=5, shuffle=True, random_state=SEED)\n",
        "\n",
        "def evaluate(name, model, Xtr=None, ytr=None, Xte=None, yte=None, store=True):\n",
        "    Xtr = X_train if Xtr is None else Xtr; ytr = y_train if ytr is None else ytr\n",
        "    Xte = X_test if Xte is None else Xte; yte = y_test if yte is None else yte\n",
        "    model.fit(Xtr, ytr)\n",
        "    p_tr, p_te = model.predict(Xtr), model.predict(Xte)\n",
        "    cv = cross_val_score(model, Xtr, ytr, cv=cv5, scoring=\"r2\")\n",
        "    row = {\"model\": name,\n",
        "           \"train R2\": r2_score(ytr, p_tr),\n",
        "           \"5-fold CV R2\": cv.mean(), \"CV R2 std\": cv.std(),\n",
        "           \"test R2\": r2_score(yte, p_te),\n",
        "           \"test RMSE\": np.sqrt(mean_squared_error(yte, p_te)),\n",
        "           \"test MAE\": mean_absolute_error(yte, p_te)}\n",
        "    return row, model, p_tr, p_te"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "mLw9lM5p9tes",
        "outputId": "218af336-3ec0-4415-beda-7d8272042c0a"
      },
