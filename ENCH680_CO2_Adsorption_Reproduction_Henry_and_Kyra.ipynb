      "source": [
        "##6. Comparison with Table 1 of the paper"
      ],
      "metadata": {
        "id": "4UfLAPSPCQRF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "paper = pd.DataFrame({\"train R2\": [0.98, 0.96, 0.92], \"5-fold CV R2\": [0.81, 0.81, 0.78],\n",
        "                      \"test R2\": [0.84, 0.83, 0.78], \"test RMSE\": [0.66, 0.68, 0.77]},\n",
        "                     index=[\"GBDT\", \"XGB\", \"LGB\"])\n",
        "comp = []\n",
        "for k in [\"GBDT\", \"XGB\", \"LGB\"]:\n",
        "    for src, lab in [(paper.loc[k], \"Paper (Table 1)\"),\n",
        "                     (results.loc[f\"{k} (authors' hyperparameters)\"], \"Ours, authors' hyperparameters\"),\n",
        "                     (results.loc[f\"{k} (our grid search)\"], \"Ours, own grid search\")]:\n",
        "        comp.append({\"model\": k, \"source\": lab, **{c: src[c] for c in paper.columns}})\n",
        "comp = pd.DataFrame(comp)\n",
        "RESULTS[\"comparison\"] = comp.round(3).to_dict(orient=\"records\")\n",
        "comp.round(2)"
      ],
